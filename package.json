{
  "name": "optitrack",
  "version": "3.0.0",
  "description": "Website for optitrack.com",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "docker compose up -d && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format",
    "format:fix": "biome format . --write",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest --config vitest.app.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.40.0",
    "@payloadcms/db-mongodb": "3.40.0",
    "@payloadcms/live-preview-react": "3.40.0",
    "@payloadcms/next": "3.40.0",
    "@payloadcms/payload-cloud": "3.40.0",
    "@payloadcms/plugin-form-builder": "3.40.0",
    "@payloadcms/plugin-nested-docs": "3.40.0",
    "@payloadcms/plugin-redirects": "3.40.0",
    "@payloadcms/plugin-search": "3.40.0",
    "@payloadcms/plugin-seo": "3.40.0",
    "@payloadcms/richtext-lexical": "3.40.0",
    "@payloadcms/ui": "3.40.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "^0.514.0",
    "next": "15.3.0",
    "next-intl": "^4.1.0",
    "next-recaptcha-v3": "^1.5.2",
    "next-sitemap": "^4.2.3",
    "payload": "3.40.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.57.0",
    "sharp": "0.32.6",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "@tailwindcss/cli": "^4.1.4",
    "@tailwindcss/postcss": "^4.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^1.9.4",
    "@chromatic-com/storybook": "^4.0.0",
    "@mdx-js/react": "^3.1.0",
    "@playwright/test": "^1.52.0",
    "@sentry/nextjs": "^9.28.1",
    "@storybook/addon-a11y": "^9.0.5",
    "@storybook/addon-docs": "^9.0.5",
    "@storybook/addon-onboarding": "^9.0.5",
    "@storybook/addon-vitest": "^9.0.5",
    "@storybook/nextjs-vite": "9.0.5",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.5.4",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser": "3.2.2",
    "@vitest/coverage-v8": "3.2.2",
    "autoprefixer": "^10.4.19",
    "copyfiles": "^2.4.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.52.0",
    "postcss": "^8.4.38",
    "storybook": "^9.0.5",
    "styled-jsx": "^5.1.7",
    "tailwindcss": "^4.1.4",
    "typescript": "5.7.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  }
}
